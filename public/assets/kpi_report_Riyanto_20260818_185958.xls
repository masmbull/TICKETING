<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>KPI Report - Riyanto</title>
    <style>
        body { font-family: 'Segoe UI', Arial, sans-serif; font-size: 12px; color: #333; }
        h1 { font-size: 16px; font-weight: bold; margin-bottom: 4px; }
        h2 { font-size: 13px; font-weight: bold; margin: 16px 0 8px; }
        h3 { font-size: 12px; font-weight: bold; margin: 12px 0 6px; }
        table { border-collapse: collapse; width: 100%; margin-bottom: 12px; }
        th, td { border: 1px solid #999; padding: 4px 8px; text-align: left; }
        th { background: #f0f0f0; font-weight: bold; font-size: 11px; }
        .metric { text-align: center; padding: 8px; }
        .metric .value { font-size: 18px; font-weight: bold; }
        .metric .label { font-size: 10px; color: #666; }
        .good { color: #16a34a; }
        .normal { color: #2563eb; }
        .poor { color: #dc2626; }
    </style>
</head>
<body>
    <h1>IT SUPPORT KPI REPORT</h1>
    <p>Staff: <strong>Riyanto</strong> | Period: <strong>01 Jan 2026 – 31 Dec 2026</strong></p>

    <h2>KPI Metrics</h2>
    <table>
        <tr>
            <th class="metric">Total Tickets Handled</th>
            <td class="metric">6</td>
            <th class="metric">Total Completed</th>
            <td class="metric">2</td>
        </tr>
        <tr>
            <th class="metric">Total In Progress</th>
            <td class="metric">0</td>
            <th class="metric">Total Waiting Confirmation</th>
            <td class="metric">4</td>
        </tr>
        <tr>
            <th class="metric">Completion Rate</th>
            <td class="metric">33.3%</td>
            <th class="metric">Avg Resolution Time</th>
            <td class="metric">25h 30m</td>
        </tr>
    </table>

    <h2>SLA Performance</h2>
    <table>
        <tr>
            <th>Excellent</th><td>2</td>
            <th>Normal</th><td>0</td>
            <th>Poor</th><td>0</td>
        </tr>
    </table>

    <h2>Category Breakdown</h2>
    <table>
        <tr>
            <th>Category</th>
            <th>Tickets</th>
            <th>Completed</th>
        </tr>
                <tr>
            <td>Hardware</td>
            <td>2</td>
            <td>2</td>
        </tr>
                <tr>
            <td>Network</td>
            <td>1</td>
            <td>0</td>
        </tr>
                <tr>
            <td>Email</td>
            <td>1</td>
            <td>0</td>
        </tr>
                <tr>
            <td>Microsoft 365</td>
            <td>1</td>
            <td>0</td>
        </tr>
                <tr>
            <td>Other</td>
            <td>1</td>
            <td>0</td>
        </tr>
            </table>

    </body>
</html>
